class MaxConsecutiveOnes {

    public static void main(String[] args) {
        int[] nums = {1, 1, 0, 1, 1, 1};

        System.out.println(findMaxConsecutiveOnes(nums));
    }

    public static int findMaxConsecutiveOnes(int[] nums) {
        int ans = 0;
        int l = 0;
        int r = 0;

        while (r < nums.length) {
            if (nums[r] == 1) {
                ans = Math.max(ans, r - l + 1);
            }

            if (nums[r] == 0) {
                l = r + 1;
            }

            r++;
        }

        return ans;
    }
}
